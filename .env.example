# ─────────────────────────────────────────────────────────────────────────────
# Roofly — root environment (read by docker compose on every host).
# Copy to `.env` and fill in real values. Everything is optional locally;
# UAT and production MUST set the values marked (required).
#
# Three environments share one VPS, so anything that binds a host port needs
# a distinct value per clone (FRONTEND_PORT, BACKEND_PORT).
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose / ports ──────────────────────────────────────────────────────────
# Project namespace — keeps demo / uat / prod containers from colliding.
#   demo.roofly.my → demo-roofly   uat.roofly.my → uat-roofly   roofly.my → roofly
COMPOSE_PROJECT_NAME=roofly

# Host port the Nuxt frontend is published on (host nginx proxies the
# subdomain here). demo 3001 · uat 3004 (3003 is taken on the VPS) · prod 3002 · local 3000
FRONTEND_PORT=3000

# Host port (loopback only) the backend nginx is published on. Host nginx
# proxies `<subdomain>/api/` to 127.0.0.1:<BACKEND_PORT>. Pick a distinct
# value per clone, e.g. uat 8004 · prod 8002 · local 8000.
BACKEND_PORT=8000

# ── Frontend (NUXT_PUBLIC_*) ────────────────────────────────────────────────
# "demo" | "uat" | "production". Unset ⇒ production (safe default: no demo
# widgets, no UAT banner). demo.roofly.my → demo · uat.roofly.my → uat · roofly.my → leave empty
NUXT_PUBLIC_APP_ENV=

# true ⇒ frontend serves in-memory mock data and never calls the API.
# demo ⇒ true (demo forces it anyway) · uat / prod ⇒ false or empty
NUXT_PUBLIC_USE_MOCK=

# (required on uat/prod) Public origin + /api that the BROWSER calls.
#   uat → https://uat.roofly.my/api   prod → https://roofly.my/api   local → http://localhost:8000/api
NUXT_PUBLIC_API_BASE=

# Canonical origin for absolute social-meta URLs (og:image, canonical).
#   uat → https://uat.roofly.my   prod → https://roofly.my
NUXT_PUBLIC_SITE_URL=

# Demo-only floating feedback widget target. Empty hides it.
NUXT_PUBLIC_DEMO_FEEDBACK_URL=https://forms.gle/ppNGGSC2cZXutpx18

# Admin back office; demo forces off regardless of this value.
NUXT_PUBLIC_FEATURE_ADMIN=true

# Phase-4 documents / photos / PDF placeholders.
NUXT_PUBLIC_FEATURE_DOCUMENTS=true

# Marketing-site analytics beacon (POST /api/track). Demo is always a no-op.
NUXT_PUBLIC_TRACKING=true

# Google sign-in for owners (OAuth web client id). Empty hides the button.
# Must match backend GOOGLE_CLIENT_ID below.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Backend (Laravel) ───────────────────────────────────────────────────────
# (required) `docker compose -f docker-compose.yml run --rm backend php artisan key:generate --show`
APP_KEY=
APP_ENV=production
APP_DEBUG=false

# (required) Public origins. FRONTEND_URL is where reset / invite mail links point.
#   uat → https://uat.roofly.my (both)   prod → https://roofly.my (both)
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# (required) Hosts allowed to use the Sanctum cookie session (comma-separated, no scheme).
#   uat → uat.roofly.my   prod → roofly.my,admin.roofly.my
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Cookie domain. prod → .roofly.my so admin.roofly.my shares the session; uat → leave null.
SESSION_DOMAIN=null

# Same OAuth web client id as NUXT_PUBLIC_GOOGLE_CLIENT_ID (backend verifies the ID token).
GOOGLE_CLIENT_ID=

# MySQL (container-internal; never published on uat/prod).
DB_DATABASE=roofly
DB_USERNAME=roofly
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# RabbitMQ (queue driver for mail + future reminders).
RABBITMQ_USER=roofly
RABBITMQ_PASSWORD=secret

# Mail. local/UAT: Mailtrap sandbox (captured, not delivered — read links in the
# Mailtrap inbox). production: a real provider. Reset / invite / warning mails are
# queued, so the queue-worker container must be running.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@roofly.my
MAIL_FROM_NAME=Roofly.my

# ── Local-dev only (docker-compose.override.yml) ────────────────────────────
# Host ports for GUI clients. Change if something on your machine already listens there.
DB_PORT_EXPOSE=3306
REDIS_PORT_EXPOSE=6379
RABBITMQ_PORT_EXPOSE=5672
RABBITMQ_MGMT_PORT=15672
PHPMYADMIN_PORT=8081
BACKEND_DEV_PORT=8000
